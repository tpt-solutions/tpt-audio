<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX installer definition for tpt-audio (Windows).

  Build with `cargo wix` (cargo-wix) from the desktop crate, or manually:

    candle.exe -dTptAudioDesktopTargetDir=target\release wix\main.wxs
    light.exe -o target\release\tpt-audio.msi wix\main.wixobj

  For a signed installer, sign the built .msi with a code-signing certificate
  (see docs/SIGNING.md) before distribution.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="tpt-audio"
    Language="1033"
    Version="$(var.TptAudioDesktopPackageVersion)"
    Manufacturer="TPT Solutions"
    UpgradeCode="6F3B8C2A-1E9D-4F7A-9B6C-2D5E8F0A1B3C">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of tpt-audio is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="tpt-audio" Level="1">
      <ComponentGroupRef Id="InstallComponents" />
      <ComponentRef Id="ApplicationStartMenuShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="tpt-audio" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="tpt-audio" />
      </Directory>
    </Directory>

    <ComponentGroup Id="InstallComponents" Directory="INSTALLDIR">
      <Component Id="MainBinary" Guid="*">
        <File Id="TptAudioExe"
              Source="$(var.TptAudioDesktopTargetPath)"
              KeyPath="yes" />
      </Component>
      <Component Id="LicenseMit" Guid="*">
        <File Source="LICENSE-MIT" KeyPath="no" />
      </Component>
      <Component Id="LicenseApache" Guid="*">
        <File Source="LICENSE-APACHE" KeyPath="no" />
      </Component>
    </ComponentGroup>

    <Component Id="ApplicationStartMenuShortcut" Guid="*" Directory="ApplicationProgramsFolder">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="tpt-audio"
                Target="[INSTALLDIR]tpt-audio-desktop.exe"
                WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\TPT Solutions\tpt-audio"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Product>
</Wix>
